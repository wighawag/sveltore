{
	"compilerOptions": {
		"outDir": "./dist",
		"lib": ["ES2022", "dom"],
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"declaration": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true
	},
	"include": ["./src/**/*", "./test/**/*"]
}
